# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_LOG_LEVEL=INFO

# ── Oracle DB (same instance as gctst-backend-new) ────────────────────────────
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=GCTST
ORACLE_WORK_USER=gctst_admin
ORACLE_USERPWD=gctst_admin123
ORACLE_SCHEMA_USER=
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=8

# ── AWS S3 (optional — leave blank to store everything in Oracle BLOB) ────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=
S3_KEY_PREFIX=documents/
S3_ENDPOINT_URL=

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_FILES_PER_REQUEST=10
MAX_FILE_SIZE_MB=50
MAX_TOTAL_SIZE_MB=200

# ── Storage strategy ──────────────────────────────────────────────────────────
# local  : filesystem binary + SQLite metadata (no Oracle or S3 required)
# minio  : MinIO object storage + SQLite metadata (no Oracle required)
# oracle : Oracle BLOB
# s3     : AWS S3
# both   : Oracle + S3 mirror
# auto   : Oracle for small files, S3 for large
STORAGE_STRATEGY=minio
AUTO_BLOB_THRESHOLD_MB=10

# ── Local storage (used when STORAGE_STRATEGY=local) ─────────────────────────
LOCAL_STORAGE_PATH=uploads/files
LOCAL_DB_PATH=uploads/documents.db

# ── MinIO (used when STORAGE_STRATEGY=minio) ──────────────────────────────────
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_KEY_PREFIX=documents/
MINIO_SECURE=false
MINIO_DB_PATH=uploads/minio_documents.db

# ── Allowed file types ────────────────────────────────────────────────────────
ALLOWED_EXTENSIONS=pdf,docx,doc,xlsx,xls,pptx,ppt,png,jpeg,jpg,gif,tiff,bmp,txt,csv,zip
